# Agentic Conversations .gitignore

# Private/sensitive files (DO NOT COMMIT)
*.env
*.key
*.pem
*.p12
*.pfx
*credentials*
*secrets*
*token*
*api_key*

# Work-in-progress drafts
drafts/
wip/
*.draft.md
*.wip.md

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Large files (should be compressed or linked)
*.zip
*.tar.gz
*.7z
*.rar

# Logs
*.log
logs/

# Personal notes (not part of conversation exports)
notes/
personal/
